{
  "name": "@neurealistic/browser-inspector",
  "version": "0.2.0",
  "description": "MCP server that drives a real Chromium over CDP for UI/DOM/network inspection, batched page-object steps, screenshot/video capture, and authed API calls — with an optional portable canonical profile store.",
  "type": "module",
  "bin": {
    "browser-inspector": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "playwright",
    "cdp",
    "browser",
    "inspector",
    "e2e",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neurealistic/browser-inspector.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
